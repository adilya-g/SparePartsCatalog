<form method="get" action="" class="search-and-sort-form">

    <div class="search-group">
        <label for="searchQuery">Поиск запчасти</label>
        <input
            type="text"
            id="searchQuery"
            name="searchQuery"
            value="{{ form.searchQuery.vars.value }}"
            placeholder="Введите название или артикул..."
            class="form-control"
        >
        <button type="submit" class="btn-search">Найти</button>
    </div>

    <div class="sort-group">
        {% if form.tagId.vars.value %}
            <input type="hidden" name="tagId" value="{{ form.tagId.vars.value }}">
        {% endif %}

        <label for="sortBy">Сортировать по:</label>
        <select name="sortBy" id="sortBy" onchange="this.form.submit()">
            <option value="date" {% if form.sortBy.vars.value == 'date' %} selected {% endif %}>
                Дате добавления
            </option>
            <option value="price" {% if form.sortBy.vars.value == 'price' %} selected {% endif %}>
                Цене
            </option>
            <option value="name" {% if form.sortBy.vars.value == 'name' %} selected {% endif %}>
                Названию
            </option>
        </select>

        <label for="sortOrder" class="visually-hidden">Направление</label>
        <select name="sortOrder" id="sortOrder" onchange="this.form.submit()">
            <option value="ASC" {% if form.sortOrder.vars.value == 'ASC' %} selected {% endif %}>
                Возрастанию (А-Я / Сначала дешевые)
            </option>
            <option value="DESC" {% if form.sortOrder.vars.value == 'DESC' %} selected {% endif %}>
                Убыванию (Я-А / Сначала дорогие)
            </option>
        </select>
    </div>

    <noscript>
        <button type="submit">Применить</button>
    </noscript>
</form>

<div class="parts-grid">
    {% for item in pagination %}
        <div class="card">
            <img class="card-img-top" src="{{ item.imagePath ?: '/images/no-photo.png' }}" alt="Фото: {{ item.name }}">
            <div class="card-body">
                <a href="#">
                    <h4>{{ item.name }}</h4>
                </a>
                <p>Артикул: {{ item.articleNumber }}</p>
                <p>Производитель: {{ item.manufacturer }}</p>
                <br>
                <h3>{{ item.price }} ₽</h3>
            </div>
        </div>
    {% else %}
        <div class="no-results">
            <p>По вашему запросу ничего не найдено. Попробуйте изменить параметры поиска.</p>
        </div>
    {% endfor %}
</div>
